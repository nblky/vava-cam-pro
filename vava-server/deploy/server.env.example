# Load using systemd EnvironmentFile or export these variables in your shell.
VAVA_DATA_DIR=/var/lib/vava-server
VAVA_DEVICE_KEYS=/etc/vava-server/devices.keys
VAVA_ADMIN_PASSWORD_FILE=/etc/vava-server/initial-admin-password
VAVA_UDP_BIND=0.0.0.0
VAVA_UDP_PORT=3731
# Default is for an HTTPS reverse proxy running on the same host.
VAVA_WEB_BIND=127.0.0.1
VAVA_WEB_PORT=8080
VAVA_WEB_DIR=/usr/local/share/vava-server/web
VAVA_FILE_QUOTA_MB=10240
VAVA_FFMPEG=/usr/bin/ffmpeg
# Direct HTTPS listener: set WEB_BIND to 0.0.0.0 and provide both files.
VAVA_WEB_CERT=
VAVA_WEB_KEY=
# Required only for a separately hosted frontend. One exact origin.
VAVA_WEB_ORIGIN=
