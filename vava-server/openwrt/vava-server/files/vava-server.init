#!/bin/sh /etc/rc.common
START=96
STOP=9
USE_PROCD=1
start_service() {
	local enabled keys bootstrap state_dir file_dir file_keyring file_quota_mb udp_bind udp_port web_bind web_port web_cert web_key web_origin media_ffmpeg
	config_load vava-server
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get keys main keys /etc/vava-server/devices.keys
	config_get bootstrap main bootstrap /etc/vava-server/initial-admin-password
	config_get state_dir main state_dir /mnt/vava-server/state
	config_get file_dir main file_dir /mnt/vava-server/recordings
	config_get file_keyring main file_keyring /mnt/vava-server/record-keys
	config_get file_quota_mb main file_quota_mb 10240
	config_get udp_bind main udp_bind 0.0.0.0
	config_get udp_port main udp_port 3731
	config_get web_bind main web_bind 127.0.0.1
	config_get web_port main web_port 8080
	config_get web_cert main web_cert
	config_get web_key main web_key
	config_get web_origin main web_origin
	config_get media_ffmpeg main media_ffmpeg /usr/bin/ffmpeg
	[ -f "$keys" ] && [ -f "$file_keyring/active" ] || { logger -t vava-server 'Provision device registry and storage keys first'; return 1; }
	case "$web_bind" in 127.0.0.1) ;; *) [ -n "$web_cert" ] && [ -n "$web_key" ] || return 1 ;; esac
	umask 077
	mkdir -p "$state_dir" "$file_dir" || return 1
	procd_open_instance
	procd_set_param command /usr/bin/vava-server --keys "$keys" --state-dir "$state_dir" \
		--bind "$udp_bind" --port "$udp_port" --file-dir "$file_dir" --file-keyring "$file_keyring" --file-quota-mb "$file_quota_mb" \
		--web-bind "$web_bind" --web-port "$web_port" --web-dir /usr/share/vava-server/web --web-admin-password-file "$bootstrap"
	[ ! -x "$media_ffmpeg" ] || procd_append_param command --media-ffmpeg "$media_ffmpeg"
	[ -z "$web_cert" ] || procd_append_param command --web-cert "$web_cert" --web-key "$web_key"
	[ -z "$web_origin" ] || procd_append_param command --web-origin "$web_origin"
	procd_set_param file /etc/config/vava-server "$keys" "$file_keyring/active"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
service_triggers() { procd_add_reload_trigger vava-server; }
