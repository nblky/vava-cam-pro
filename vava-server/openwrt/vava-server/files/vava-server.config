config service 'main'
	option enabled '0'
	option keys '/etc/vava-server/devices.keys'
	option bootstrap '/etc/vava-server/initial-admin-password'
	option state_dir '/mnt/vava-server/state'
	option file_dir '/mnt/vava-server/recordings'
	option file_keyring '/mnt/vava-server/record-keys'
	option file_quota_mb '10240'
	option udp_bind '0.0.0.0'
	option udp_port '3731'
	# Without TLS, a reverse proxy must use this loopback listener.
	option web_bind '127.0.0.1'
	option web_port '8080'
	option web_cert ''
	option web_key ''
	option web_origin ''
	option media_ffmpeg '/usr/bin/ffmpeg'
