#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
	local record_keyring local_only pairing_serial archive_serial continuous_quality
	local enabled state_dir camera_bind ssid password_file storage_mount record_dir record_max_mb event_dir event_limit event_parent
	local nas_host nas_export nas_mount
	local time_offset_seconds ap_helper storage_real record_parent server_host server_port device_id server_key_file server_poll_ms
	config_load vava-agent
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get state_dir main state_dir /etc/vava-state
	config_get camera_bind main camera_bind 172.26.168.1
	config_get ssid main ssid VAVA-Local
	config_get pairing_serial main pairing_serial
	config_get archive_serial main archive_serial
	config_get_bool local_only main local_only 0
	config_get_bool continuous_quality main continuous_quality 0
	config_get password_file main password_file /etc/vava/wifi-key
	config_get storage_mount main storage_mount /mnt/vava
	config_get record_dir main record_dir /mnt/vava/recordings
	config_get record_max_mb main record_max_mb 512
	config_get record_keyring main record_keyring /etc/vava/record-keys
	[ -n "$record_keyring" ] && [ -f "$record_keyring/active" ] || { logger -t vava-agent 'recording keyring must be provisioned before enabling'; return 1; }
	config_get event_dir main event_dir /mnt/vava/events
	config_get event_limit main event_limit 1024
	config_get time_offset_seconds main time_offset_seconds 28800
	config_get ap_helper main ap_helper /usr/libexec/vava-ap
	config_get server_host main server_host
	config_get server_port main server_port 3731
	config_get device_id main device_id
	config_get server_key_file main server_key_file /etc/vava/server-key
	config_get server_poll_ms main server_poll_ms 1000
	config_get nas_host main nas_host
	config_get nas_export main nas_export
	config_get nas_mount main nas_mount /mnt/vava-nas
	[ "$local_only" = 1 ] || { [ -n "$server_host" ] && [ -n "$device_id" ] && [ -f "$server_key_file" ]; } || {
		logger -t vava-agent 'server configuration or device credential missing'; return 1;
	}
	case "$storage_mount" in /*) ;; *) return 1 ;; esac
	case "$storage_mount" in /|*/../*|*/./*|*/..|*/.) return 1 ;; esac
	case "$record_dir" in "$storage_mount"/*) ;; *) return 1 ;; esac
	case "$event_dir" in "$storage_mount"/*) ;; *) return 1 ;; esac
	case "$record_dir/$event_dir" in */../*|*/./*|*/..|*/.) return 1 ;; esac
	[ "$event_dir" != "$record_dir" ] || return 1
	# No card I/O here: the storage workers verify the real mount and walk
	# components without following symlinks before creating their directories.
	umask 077
	mkdir -p "$state_dir" || return 1
	chmod 700 "$state_dir" || return 1
	if [ -n "$nas_host" ]; then
		case "$nas_mount" in /*) ;; *) return 1 ;; esac
		case "$nas_mount" in /|*/../*|*/./*|*/..|*/.) return 1 ;; esac
		[ -n "$nas_export" ] && [ ! -L "$nas_mount" ] || return 1
		# Never change permissions on an existing mounted remote export.
		[ -d "$nas_mount" ] || mkdir -m 700 -p "$nas_mount" || return 1
	fi
	procd_open_instance
	procd_set_param command /usr/bin/vava-agent --state-dir "$state_dir" --bind "$camera_bind" \
		--ssid "$ssid" --password-file "$password_file" --record-dir "$record_dir" --storage-mount "$storage_mount" --record-max-mb "$record_max_mb" --record-keyring "$record_keyring" \
		--time-offset-seconds "$time_offset_seconds" --ap-helper "$ap_helper" \
		--event-dir "$event_dir" --event-limit "$event_limit" --nas-mount "$nas_mount"
	[ "$continuous_quality" = 0 ] || procd_append_param command --continuous-quality 1
	[ "$local_only" = 1 ] || procd_append_param command --server-host "$server_host" --server-port "$server_port" \
		--device-id "$device_id" --server-key-file "$server_key_file" --server-poll-ms "$server_poll_ms"
	[ -z "$pairing_serial" ] || procd_append_param command --pairing-serial "$pairing_serial"
	[ -z "$archive_serial" ] || procd_append_param command --archive-serial "$archive_serial"
	[ -n "$nas_host" ] && procd_append_param command --nas-host "$nas_host" --nas-export "$nas_export" --nas-station-id "$device_id"
	[ -f /tmp/vava-clock-synced ] && procd_append_param command --clock-valid
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 8
	procd_set_param file /etc/config/vava-agent "$password_file" "$server_key_file" "$record_keyring/active"
	procd_close_instance
}

stop_service() {
	/usr/libexec/vava-ap close </dev/null
}

service_triggers() {
	procd_add_reload_trigger vava-agent
}
