#!/bin/sh
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
export LC_ALL
[ "$#" -eq 2 ] || [ "$#" -eq 4 ] || exit 2
if [ "$#" -eq 4 ]; then
    [ "$3" = confirm ] || exit 2
    case "$4" in ''|*[!a-f0-9]*) exit 2 ;; esac
    [ "${#4}" -eq 16 ] || exit 2
fi
case "$1" in 0|1|2|3) ;; *) exit 2 ;; esac
case "$2" in ''|*[!A-Za-z0-9_.:-]*) exit 2 ;; esac
[ "${#2}" -le 31 ] || exit 2
state_dir="$(uci -q get vava-agent.main.state_dir || true)"
[ -n "$state_dir" ] || state_dir=/etc/vava-state
case "$state_dir" in /*) ;; *) exit 2 ;; esac
case "$state_dir" in /|*/../*|*/./*|*/..|*/.) exit 2 ;; esac
if [ "$#" -eq 4 ]; then
    exec /usr/bin/vavactl -s "$state_dir/control.sock" if-serial "$2" remove-confirm "$1" "$4"
fi
exec /usr/bin/vavactl -s "$state_dir/control.sock" if-serial "$2" remove "$1"
