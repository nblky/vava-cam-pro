#!/bin/sh
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
export LC_ALL
[ "$#" -eq 4 ] || exit 2
case "$1" in 0|1|2|3) ;; *) exit 2 ;; esac
case "$2" in ''|*[!A-Za-z0-9_.:-]*) exit 2 ;; esac
[ "${#2}" -le 31 ] || exit 2
case "$3" in ''|*[!0-9]*|0[0-9]*) exit 2 ;; esac
[ "${#3}" -le 10 ] || exit 2
[ "$3" -le 4294967295 ] || exit 2
[ "${#4}" -le 96 ] || exit 2
state_dir="$(uci -q get vava-agent.main.state_dir || true)"
[ -n "$state_dir" ] || state_dir=/etc/vava-state
case "$state_dir" in /*) ;; *) exit 2 ;; esac
case "$state_dir" in /|*/../*|*/./*|*/..|*/.) exit 2 ;; esac
exec /usr/bin/vavactl -s "$state_dir/control.sock" if-serial "$2" if-revision "$3" name "$1" "$4"
