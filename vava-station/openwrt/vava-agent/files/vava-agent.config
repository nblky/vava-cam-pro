config service 'main'
	option enabled '0'
	option state_dir '/etc/vava-state'
	option camera_bind '172.26.168.1'
	option ssid 'VAVA-Local'
	# Optional original 25-character serial, used only for temporary AP credentials.
	option pairing_serial ''
	# Explicit standalone operation for camera pairing without a remote server.
	option local_only '0'
	option password_file '/etc/vava/wifi-key'
	option storage_mount '/mnt/vava'
	option record_dir '/mnt/vava/recordings'
	option record_max_mb '512'
	# Create with vava-agent --storage-key-create before enabling; back up this directory.
	option record_keyring '/etc/vava/record-keys'
	option event_dir '/mnt/vava/events'
	option event_limit '1024'
	option time_offset_seconds '28800'
	option ap_helper '/usr/libexec/vava-ap'
	# Credentials must be provisioned before enabling the service. No shared default key.
	option server_host ''
	option server_port '3731'
	option device_id ''
	option server_key_file '/etc/vava/server-key'
	option server_poll_ms '1000'

	# Optional base-owned NFS archive; per-camera policy nas=1 enables new PIR clips.
	option nas_host ''
	option nas_export ''
	option nas_mount '/mnt/vava-nas'

	# Logical archive serial (25 letters/digits); independent of server device_id.
	# option archive_serial '0123456789ABCDEFG12345678'

	# Optional HTTPS URL of your independent management service.
	option management_url ''
